{
  "manifest_version": 3,
  "name": "Nabo MCP Lite",
  "version": "0.2.0",
  "description": "Local MCP browser control bridge",
  "permissions": [
    "tabs",
    "activeTab",
    "debugger",
    "scripting",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icon-32.png"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["buildDomTree.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
